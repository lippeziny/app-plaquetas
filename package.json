{
  "name": "plaquetas-by-lippe",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "dev:api": "node --watch server/index.cjs",
    "start:server": "node server/index.cjs",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:start:web\"",
    "build:web": "expo export --platform web",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-picker/picker": "2.11.1",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "expo": "~54.0.25",
    "expo-camera": "~17.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.19",
    "expo-font": "~14.0.9",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "better-sqlite3": "^12.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "dotenv": "^16.6.1",
    "@expo/metro-runtime": "~6.1.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2",
    "@types/node": "^22.15.0"
  }
}
