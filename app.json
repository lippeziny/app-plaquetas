{
  "expo": {
    "name": "Plaquetas",
    "slug": "plaquetas-by-lippe",
    "version": "4.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "plaquetas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lippe.plaquetas",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para ler o QR Code ou código de barras dos itens durante a contagem."
      }
    },
    "android": {
      "package": "com.lippe.plaquetas",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Plaquetas leia QR Codes e códigos de barras dos itens.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "react-native-zip-archive",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
