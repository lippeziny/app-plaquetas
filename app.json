{
  "expo": {
    "name": "Plaquetas",
    "slug": "plaquetas-by-lippe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "plaquetas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lippe.plaquetas",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para ler o QR Code ou código de barras dos itens durante a contagem."
      }
    },
    "android": {
      "package": "com.lippe.plaquetas",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Plaquetas leia QR Codes e códigos de barras dos itens.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
