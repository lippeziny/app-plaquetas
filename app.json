{
  "expo": {
    "name": "Plaquetas",
    "slug": "plaquetas-by-lippe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "plaquetas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lippe.plaquetas",
      "infoPlist": {
        "NSCameraUsageDescription": "A c\u00e2mera \u00e9 usada para ler o QR Code ou c\u00f3digo de barras dos itens durante a contagem."
      }
    },
    "android": {
      "package": "com.lippe.plaquetas",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Plaquetas leia QR Codes e c\u00f3digos de barras dos itens."
        }
      ],
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
